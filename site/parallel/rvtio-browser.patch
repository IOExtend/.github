+    private static void WriteBrowserParameters(BinaryWriter writer, NativeParams values, Dictionary<string, int>? strings)
+    {
+        writer.Write(values.RootParameterStoresComplete);
+        writer.Write(values.TailWalkComplete);
+        writer.Write(values.CellClasses?.Length ?? -1);
+        if (values.CellClasses != null)
+            foreach (int item in values.CellClasses) writer.Write(item);
+        writer.Write(values.RoofExtrusionFaceTags?.Count ?? -1);
+        if (values.RoofExtrusionFaceTags != null)
+            foreach (int item in values.RoofExtrusionFaceTags) writer.Write(item);
+        writer.Write(values.Doubles.Count);
+        foreach (var (id, value) in values.Doubles) { writer.Write(id); writer.Write(value); }
+        writer.Write(values.Ints.Count);
+        foreach (var (id, value) in values.Ints) { writer.Write(id); writer.Write(value); }
+        writer.Write(values.Strings.Count);
+        foreach (var (id, value) in values.Strings) { writer.Write(id); WriteBrowserString(writer, value, strings); }
+        writer.Write(values.ElementIds.Count);
+        foreach (var (id, value) in values.ElementIds) { writer.Write(id); writer.Write(value); }
+        writer.Write(values.NamedParams.Count);
+        foreach (var value in values.NamedParams)
+        {
+            writer.Write(value.ParamId);
+            writer.Write(value.Str != null);
+            if (value.Str != null) WriteBrowserString(writer, value.Str, strings);
+            writer.Write(value.Value);
+            writer.Write(value.ElemId);
+            writer.Write(value.Int);
+            writer.Write(value.Instance);
+            writer.Write(value.Reporting);
+        }
+        writer.Write(values.Fields.Count);
+        foreach (var (key, value) in values.Fields) { WriteBrowserString(writer, key, strings); writer.Write(value); }
+        var doubles = values.CapturedDoubleFields;
+        writer.Write(doubles?.Count ?? 0);
+        if (doubles != null)
+            foreach (var (key, value) in doubles) { WriteBrowserString(writer, key, strings); writer.Write(value); }
+        var stringsByField = values.CapturedStringFields;
+        writer.Write(stringsByField?.Count ?? 0);
+        if (stringsByField != null)
+            foreach (var (key, value) in stringsByField) { WriteBrowserString(writer, key, strings); WriteBrowserString(writer, value, strings); }
+    }
+
+    private static NativeParams ReadBrowserParameters(BinaryReader reader, List<string>? strings)
+    {
+        var values = new NativeParams
+        {
+            RootParameterStoresComplete = reader.ReadBoolean(),
+            TailWalkComplete = reader.ReadBoolean(),
+        };
+        int length = reader.ReadInt32();
+        if (length >= 0)
+        {
+            values.CellClasses = new int[length];
+            for (int i = 0; i < length; i++) values.CellClasses[i] = reader.ReadInt32();
+        }
+        length = reader.ReadInt32();
+        if (length >= 0)
+        {
+            values.RoofExtrusionFaceTags = new(length);
+            for (int i = 0; i < length; i++) values.RoofExtrusionFaceTags.Add(reader.ReadInt32());
+        }
+        length = reader.ReadInt32();
+        values.Doubles.EnsureAdditionalCapacity(length);
+        for (int i = 0; i < length; i++) values.Doubles.Add((reader.ReadInt32(), reader.ReadDouble()));
+        length = reader.ReadInt32();
+        values.Ints.EnsureAdditionalCapacity(length);
+        for (int i = 0; i < length; i++) values.Ints.Add((reader.ReadInt32(), reader.ReadInt32()));
+        length = reader.ReadInt32();
+        values.Strings.EnsureAdditionalCapacity(length);
+        for (int i = 0; i < length; i++) values.Strings.Add((reader.ReadInt32(), ReadBrowserString(reader, strings)));
+        length = reader.ReadInt32();
+        values.ElementIds.EnsureAdditionalCapacity(length);
+        for (int i = 0; i < length; i++) values.ElementIds.Add((reader.ReadInt32(), reader.ReadInt32()));
+        length = reader.ReadInt32();
+        values.NamedParams.EnsureAdditionalCapacity(length);
+        for (int i = 0; i < length; i++)
+            values.NamedParams.Add(new(reader.ReadInt32(), reader.ReadBoolean() ? ReadBrowserString(reader, strings) : null,
+                reader.ReadDouble(), reader.ReadInt32(), reader.ReadInt32(), reader.ReadBoolean(), reader.ReadBoolean()));
+        length = reader.ReadInt32();
+        for (int i = 0; i < length; i++) values.Fields.Add(ReadBrowserString(reader, strings), reader.ReadInt32());
+        length = reader.ReadInt32();
+        for (int i = 0; i < length; i++) values.DoubleFields.Add(ReadBrowserString(reader, strings), reader.ReadDouble());
+        length = reader.ReadInt32();
+        for (int i = 0; i < length; i++) values.StringFields.Add(ReadBrowserString(reader, strings), ReadBrowserString(reader, strings));
+        return values;
+    }
+}
