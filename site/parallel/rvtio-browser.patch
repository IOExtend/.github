+using System.Globalization;
+using System.Runtime.InteropServices;
+using System.Text;
+using RvtIO.Parsing;
+
+namespace RvtIO;
+
+public partial class RvtFileReader
+{
+    /// <summary>Starts a browser worker with the exact ID snapshot and comparison culture.</summary>
+    public static Func<byte[], string, bool>? BrowserBeginNameScan { get; set; }
+
+    /// <summary>Queues a complete chunk for the browser name scanner.</summary>
+    public static Action<int, byte[]>? BrowserSendNameChunk { get; set; }
+
+    /// <summary>Seals the name scan input.</summary>
+    public static Action? BrowserSealNameScan { get; set; }
+
+    /// <summary>Gets ordered name contributions after the main parser's overlapping work.</summary>
+    public static Func<byte[]>? BrowserCollectNameScan { get; set; }
+
+    private const long NameInputBudget = 96 * 1024 * 1024;
+    private static HashSet<uint>? _sideNameIds;
+    private static Dictionary<uint, List<string>>? _sideNames;
+    private static Dictionary<uint, HashSet<string>>? _sideNameSeen;
+    private static int _sideLastChunk;
+    private static int _sideChunkCount;
+
+    /// <summary>Initializes a dedicated worker's name scanner.</summary>
+    public static void BeginBrowserNameScan(byte[] ids, string culture)
+    {
+        if (_sideNameIds != null || ids.Length % sizeof(uint) != 0)
+            throw new InvalidDataException("Invalid name scanner initialization.");
+        CultureInfo.CurrentCulture = CultureInfo.GetCultureInfo(culture);
+        _sideNameIds = new HashSet<uint>(ids.Length / sizeof(uint));
+        foreach (uint id in MemoryMarshal.Cast<byte, uint>(ids.AsSpan()))
+            _sideNameIds.Add(id);
+        _sideNames = new();
+        _sideNameSeen = new();
+        _sideLastChunk = -1;
+        _sideChunkCount = 0;
+    }
+
+    /// <summary>Scans an entire chunk and merges the names in source chunk order.</summary>
+    public static void ScanBrowserNameChunk(int index, byte[] data)
+    {
+        if (_sideNameIds == null || index <= _sideLastChunk)
+            throw new InvalidDataException("Name scanner chunk order differs.");
+        var names = new Dictionary<uint, List<string>>();
+        StringScanner.ScanChunk(data, _sideNameIds, names);
+        MergeElemScanStringChunk(names, _sideNames!, _sideNameSeen!);
+        _sideLastChunk = index;
+        _sideChunkCount++;
+    }
+
+    /// <summary>Encodes the merged owner lists using a shared ordinal string table.</summary>
+    public static byte[] FinishBrowserNameScan()
+    {
+        var names = _sideNames ?? throw new InvalidOperationException("Missing name scanner.");
+        var table = new Dictionary<string, int>(StringComparer.Ordinal);
+        using var ownerData = new MemoryStream();
+        using var ownerWriter = new BinaryWriter(ownerData, Encoding.UTF8, leaveOpen: true);
+        foreach (var (id, values) in names)
+        {
+            ownerWriter.Write(id);
+            ownerWriter.Write(values.Count);
+            foreach (string value in values)
+            {
+                if (!table.TryGetValue(value, out int index))
+                {
+                    index = table.Count;
+                    table.Add(value, index);
+                }
+                ownerWriter.Write(index);
+            }
+        }
+        using var output = new MemoryStream();
+        using var writer = new BinaryWriter(output, Encoding.UTF8, leaveOpen: true);
+        writer.Write(_sideChunkCount);
+        writer.Write(table.Count);
+        foreach (string value in table.Keys) WriteBrowserString(writer, value);
+        writer.Write(names.Count);
+        writer.Write(ownerData.GetBuffer().AsSpan(0, (int)ownerData.Length));
+        _sideNameIds = null;
+        _sideNames = null;
+        _sideNameSeen = null;
+        return output.ToArray();
+    }
+
+    private static Action<Dictionary<uint, List<string>>?[]>? TryStartBrowserNameScan(
+        IReadOnlyList<byte[]> chunks, HashSet<uint> scanIds)
+    {
+        if (BrowserBeginNameScan is not { } begin || BrowserSendNameChunk is not { } send
+            || BrowserSealNameScan is not { } seal || BrowserCollectNameScan is not { } collect)
+            return null;
+        uint[] ids = scanIds.ToArray();
+        if (!begin(MemoryMarshal.AsBytes(ids.AsSpan()).ToArray(), CultureInfo.CurrentCulture.Name))
+            return null;
+
+        int prefix = 0, sent = 0;
+        long bytes = 0;
+        for (; prefix < chunks.Count; prefix++)
+        {
+            var chunk = chunks[prefix];
+            if (chunk.Length > NameInputBudget - bytes) break;
+            if (chunk.Length < 6) continue;
+            send(prefix, chunk);
+            sent++;
+            bytes += chunk.Length;
+        }
+        seal();
+
+        return result =>
+        {
+            byte[] encoded = collect();
+            if (encoded.Length == 0 || prefix == 0) return;
+            using var source = new MemoryStream(encoded, writable: false);
+            using var reader = new BinaryReader(source);
+            if (reader.ReadInt32() != sent)
+                throw new InvalidDataException("Incomplete name worker prefix.");
+            var table = new string[reader.ReadInt32()];
+            for (int i = 0; i < table.Length; i++) table[i] = ReadBrowserString(reader);
+            int owners = reader.ReadInt32();
+            var merged = new Dictionary<uint, List<string>>(owners);
+            for (int i = 0; i < owners; i++)
+            {
+                uint id = reader.ReadUInt32();
+                int size = reader.ReadInt32();
+                var values = new List<string>(size);
+                for (int j = 0; j < size; j++) values.Add(table[reader.ReadInt32()]);
+                merged.Add(id, values);
+            }
+            if (source.Position != source.Length)
+                throw new InvalidDataException("Unexpected name worker data.");
+
+            result[0] = merged;
+            var completedEmpty = new Dictionary<uint, List<string>>();
+            Array.Fill(result, completedEmpty, 1, prefix - 1);
+            Console.WriteLine($"IOExtend name prefix {prefix}/{chunks.Count} input {bytes} output {encoded.Length}, {table.Length} names.");
+        };
+    }
+}
