+using System.Runtime.InteropServices;
+using System.Text;
+using RvtIO.Parsing;
+using static RvtIO.Parsing.TfBlockDeserializer;
+
+namespace RvtIO;
+
+public partial class RvtFileReader
+{
+    private static readonly bool ParameterStringTable = Environment.GetEnvironmentVariable("IOEXTEND_PROBE_PARAM_STRING_CONTROL") != "1";
+
+    /// <summary>Dispatches local browser parameter work.</summary>
+    public static Func<byte[], byte[], byte[], byte[], byte[]>? BrowserDecodeParameterBatches { get; set; }
+
+    /// <summary>Decodes one independent browser parameter batch.</summary>
+    public static byte[] DecodeBrowserParameterBatch(byte[] input)
+    {
+        using var source = new MemoryStream(input, writable: false);
+        using var reader = new BinaryReader(source);
+        using var output = new MemoryStream();
+        using var writer = new BinaryWriter(output, Encoding.UTF8, leaveOpen: true);
+        var strings = ParameterStringTable ? new Dictionary<string, int>(StringComparer.Ordinal) : null;
+        while (source.Position < source.Length)
+        {
+            int group = reader.ReadInt32();
+            bool hasNative = reader.ReadBoolean(), hasRoot = reader.ReadBoolean(), r22View = reader.ReadBoolean();
+            int jobs = reader.ReadInt32();
+            for (int j = 0; j < jobs; j++)
+            {
+                int index = reader.ReadInt32();
+                uint size = reader.ReadUInt32();
+                ushort cls = reader.ReadUInt16();
+                bool root = reader.ReadBoolean();
+                int start = checked((int)source.Position);
+                source.Seek(checked((int)size + 16), SeekOrigin.Current);
+                if (source.Position > source.Length) throw new InvalidDataException("Incomplete parameter block.");
+                bool mergeDrive = hasNative && root && hasRoot && r22View && IsSubclassOf(cls, 1794);
+                if (hasNative && (!root || hasRoot) && !mergeDrive) continue;
+                var values = ExtractParams(input, start, size, cls);
+                if (values == null || (!mergeDrive && values.Count == 0)) continue;
+                // Complex entities are replayed through the regular decoder for this owner.
+                if (values.ExtensibleStorage != null)
+                {
+                    writer.Write(~group);
+                    continue;
+                }
+                if (!mergeDrive)
+                {
+                    hasNative = true;
+                    hasRoot |= root;
+                }
+                writer.Write(index);
+                writer.Write(root && !mergeDrive);
+                writer.Write(mergeDrive);
+                WriteBrowserParameters(writer, values, strings);
+            }
+        }
+        return output.ToArray();
+    }
+
+    private static void WriteBrowserString(BinaryWriter writer, string value,
+        Dictionary<string, int>? table = null)
+    {
+        if (table != null)
+        {
+            int index = table.Count;
+            ref int entry = ref CollectionsMarshal.GetValueRefOrAddDefault(table, value, out bool existing);
+            if (existing)
+            {
+                writer.Write(~entry);
+                return;
+            }
+            entry = index;
+        }
+        writer.Write(value.Length);
+        writer.Write(MemoryMarshal.AsBytes(value.AsSpan()));
+    }
+
+    private static string ReadBrowserString(BinaryReader reader, List<string>? table = null)
+    {
+        int token = reader.ReadInt32();
+        if (token < 0)
+        {
+            int index = ~token;
+            if (table == null || (uint)index >= (uint)table.Count)
+                throw new InvalidDataException("Unknown parameter string reference.");
+            return table[index];
+        }
+        string value = string.Create(token, reader.BaseStream,
+            static (chars, stream) => stream.ReadExactly(MemoryMarshal.AsBytes(chars)));
+        table?.Add(value);
+        return value;
+    }
