+using System.Buffers.Binary;
+
+namespace RvtIO.Parsing;
+
+internal static partial class GRepParserV2
+{
+    private const int GLineBytes = 80, GArcBytes = 113, GEllipseBytes = 120;
+    private const int GInfoBytes = 16;
+    private const int GRepScalarBytes = 2 * 6 * sizeof(double) + 2 * sizeof(int);
+    private static readonly Lazy<bool> CurveOnlyLayout = new(() =>
+    {
+        TfBlockDeserializer.TfField info = new("m_GInfo", 14, 0, null, null, 1246);
+        TfBlockDeserializer.TfField nodes = new("m_subNodes", 14, 81, null, null, 2009);
+        TfBlockDeserializer.TfField[] root =
+        [
+            info, nodes, new("m_bBox", 13, 16, null, 2, 2008),
+            new("m_tightbBox", 13, 16, null, 2, 2008),
+            new("m_gElemType", 4, 0, null, null, 2008), new("m_flags", 5, 0, null, null, 2008),
+        ];
+        return TfBlockDeserializer.SerializationFields(2007)?.SequenceEqual(root) == true
+            && TfBlockDeserializer.SerializationFields(2009)?.SequenceEqual([info, nodes]) == true
+            && TfBlockDeserializer.Schemas.ContainsKey(1736)
+            && TfBlockDeserializer.Schemas.ContainsKey(1974)
+            && TfBlockDeserializer.Schemas.ContainsKey(2010);
+    });
+
+    // The mesh walker only uses these curves as profiles of other nodes. A complete graph
+    // containing only groups and these profiles cannot contribute edges, mesh faces or instances.
+    internal static bool IsCurveOnlyRepresentation(byte[] data, int start, uint size)
+    {
+        if (start < 0 || size < 2 + GInfoBytes + sizeof(int) + GRepScalarBytes
+            || (long)start + 16 + size > data.Length
+            || BinaryPrimitives.ReadUInt16LittleEndian(data.AsSpan(start + 12, 2)) != 2007
+            || !CurveOnlyLayout.Value) return false;
+
+        ReadOnlySpan<byte> remaining = data.AsSpan(start + 14, (int)size - 2);
+        Span<ushort> queue = stackalloc ushort[64];
+        int end = 0;
+        if (!ReadCurveGroup(ref remaining, queue, ref end) || remaining.Length < GRepScalarBytes) return false;
+        remaining = remaining[GRepScalarBytes..];
+
+        for (int index = 0; index < end; index++)
+        {
+            if (queue[index] == 2009)
+            {
+                if (!ReadCurveGroup(ref remaining, queue, ref end)) return false;
+                continue;
+            }
+            int length = queue[index] switch
+            {
+                1736 => GLineBytes,
+                1974 => GArcBytes,
+                2010 => GEllipseBytes,
+                _ => 0,
+            };
+            if (length == 0 || remaining.Length < length) return false;
+            remaining = remaining[length..];
+        }
+        // Extra bytes could include an unwalked face graph recovered by the ordinary decoder.
+        return remaining.IsEmpty;
+    }
+
+    private static bool ReadCurveGroup(ref ReadOnlySpan<byte> bytes, scoped Span<ushort> queue, ref int end)
+    {
+        if (bytes.Length < GInfoBytes + sizeof(int)
+            || BinaryPrimitives.ReadInt32LittleEndian(bytes[8..]) < -3_000_000) return false;
+        uint count = BinaryPrimitives.ReadUInt32LittleEndian(bytes[GInfoBytes..]);
+        bytes = bytes[(GInfoBytes + sizeof(int))..];
+        if (count == uint.MaxValue) return true;
+        if (count > 64 || count > bytes.Length / sizeof(int)) return false;
+        for (uint index = 0; index < count; index++)
+        {
+            if (bytes.Length < sizeof(int)) return false;
+            int handle = BinaryPrimitives.ReadInt32LittleEndian(bytes);
+            bytes = bytes[sizeof(int)..];
+            if (handle == 0) continue;
+            if (bytes.Length < sizeof(ushort) || end == queue.Length) return false;
+            ushort cls = BinaryPrimitives.ReadUInt16LittleEndian(bytes);
+            if (cls is not (1736 or 1974 or 2010 or 2009)) return false;
+            queue[end++] = cls;
+            bytes = bytes[sizeof(ushort)..];
+        }
+        return true;
+    }
