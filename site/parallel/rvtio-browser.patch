+        {
+            Records = reader.ReadInt32(), RecordsRewritten = reader.ReadInt32(),
+            RootBlocks = reader.ReadInt32(), RootBlocksRewritten = reader.ReadInt32(),
+            OtherBlocks = reader.ReadInt32(), OtherBlocksRewritten = reader.ReadInt32(),
