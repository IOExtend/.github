+namespace RvtIO.Parsing;
+
+internal sealed partial class R22Transcoder
+{
+    private sealed class NeedsRemapping : Exception;
+
+    private readonly record struct RangeResult(ReadOnlyMemory<byte> Bytes, int[] Ends, Stats Stats, int[]? Ids);
+
+    private R22Transcoder(R22Transcoder source, bool trackIds)
+    {
+        _source = source._source;
+        _target = source._target;
+        _targetByName = source._targetByName;
+        _tagMap = source._tagMap;
+        _sourceWidth = source._sourceWidth;
+        _sourceIdentifier = source._sourceIdentifier;
+        _bulkScalars = source._bulkScalars;
+        if (trackIds) _identityIds = [];
+    }
+
+    private bool HasIdMap => _ids != null || _identityIds != null;
+
+    private int MapId(long id)
+    {
+        if (_identityIds == null) return _ids!.Key(id);
+        if (id is < int.MinValue or > int.MaxValue) throw new NeedsRemapping();
+        int key = (int)id;
+        if (key > 0) _identityIds.Add(key);
+        return key;
+    }
+
+    private bool TryParallelStream(byte[] source, Func<byte[], byte[], byte[]>? browserRewrite,
+        out List<byte[]> result, out Stats stats)
+    {
+        const int rangeBytes = 1024 * 1024;
+        result = [];
+        stats = new();
+        if (_ids?.HasRemappedIds == true || source.Length > 128 * rangeBytes
+            || (browserRewrite != null && source.Length < 8 * rangeBytes)) return false;
+
+        var items = new List<StreamItem>();
+        int stop = ScanStream(source, items.Add);
+        var ranges = new List<(int First, int End)>();
+        int first = 0;
+        for (int i = 0; i < items.Count; i++)
+        {
+            var item = items[i];
+            if (item.Start + item.Length - items[first].Start < rangeBytes && i + 1 < items.Count) continue;
+            ranges.Add((first, i + 1));
+            first = i + 1;
+        }
+        if (ranges.Count < 2) return false;
+
+        var rewrites = browserRewrite == null
+            ? RewriteNativeRanges(source, items, ranges)
+            : RewriteBrowserRanges(source, items, ranges, browserRewrite);
+        if (rewrites == null) return false;
+
+        using var output = new MemoryStream();
+        for (int index = 0; index < rewrites.Length; index++)
+        {
+            var range = rewrites[index]!.Value;
+            if (range.Ids != null)
+                foreach (int id in range.Ids) _ids!.Key(id);
+            MergeRangeStats(stats, range.Stats);
+            for (int i = 0; i + 1 < range.Ends.Length; i++)
+            {
+                output.Write(range.Bytes.Span[range.Ends[i]..range.Ends[i + 1]]);
+                FlushAfterItem(output, result, items[ranges[index].First + i].Kind);
+            }
+        }
+        stats.ParallelRanges = ranges.Count;
+        FinishStream(source, stop, output, result, stats);
+        return true;
+    }
+
+    private RangeResult?[]? RewriteNativeRanges(byte[] source, List<StreamItem> items, List<(int First, int End)> ranges)
+    {
+        var rewrites = new RangeResult?[ranges.Count];
+        var loop = Parallel.For(0, ranges.Count, new ParallelOptions { MaxDegreeOfParallelism = 4 },
+            () => new R22Transcoder(this, trackIds: _ids != null),
+            (index, state, worker) =>
+            {
+                var (begin, end) = ranges[index];
+                try { rewrites[index] = worker.RewriteRange(source, items, begin, end); }
+                catch (NeedsRemapping) { state.Stop(); }
+                return worker;
+            },
+            _ => { });
+        // A worker cannot allocate aliases out of order. The serial pass starts from the untouched ID map.
+        return loop.IsCompleted ? rewrites : null;
+    }
+
+    private RangeResult RewriteRange(byte[] source, List<StreamItem> items, int first, int end)
+    {
+        _identityIds?.Clear();
+        using var output = new MemoryStream();
+        var ends = new int[end - first + 1];
+        var stats = new Stats();
+        for (int i = first; i < end; i++)
+        {
+            WriteStreamItem(source, items[i], output, stats);
+            ends[i - first + 1] = checked((int)output.Length);
+        }
+        return new(output.ToArray(), ends, stats, _identityIds?.ToArray());
+    }
+
+    private static void MergeRangeStats(Stats output, Stats input)
+    {
+        output.Records += input.Records;
+        output.RecordsRewritten += input.RecordsRewritten;
+        output.RootBlocks += input.RootBlocks;
+        output.RootBlocksRewritten += input.RootBlocksRewritten;
+        output.OtherBlocks += input.OtherBlocks;
+        output.OtherBlocksRewritten += input.OtherBlocksRewritten;
+        foreach (var (reason, count) in input.Failures)
+            output.Failures[reason] = output.Failures.GetValueOrDefault(reason) + count;
+    }
+}
