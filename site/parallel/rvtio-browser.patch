+    internal byte[] EncodeBrowserRange(byte[] input, byte[] plan)
+    {
+        const int entryBytes = 3 * sizeof(int);
+        if (plan.Length == 0 || plan.Length % entryBytes != 0)
+            throw new InvalidDataException("Incomplete R22 range plan.");
+        using var reader = new BinaryReader(new MemoryStream(plan, writable: false));
+        var items = new List<StreamItem>(plan.Length / entryBytes);
+        int position = 0;
+        while (reader.BaseStream.Position < reader.BaseStream.Length)
+        {
+            int offset = reader.ReadInt32(), length = reader.ReadInt32(), kind = reader.ReadInt32();
+            if (offset != position || length <= 0 || length > input.Length - position
+                || (uint)kind > (uint)StreamItemKind.SectionEnd)
+                throw new InvalidDataException("Invalid R22 range entry.");
+            var item = new StreamItem(offset, length, (StreamItemKind)kind);
+            bool valid = item.Kind switch
+            {
+                StreamItemKind.Record => TryRecord(input, offset, _sourceWidth, out int actual) && length == actual,
+                StreamItemKind.Block or StreamItemKind.RootBlock => TryBlock(input, offset, _sourceWidth, out int actual) && length == actual,
+                StreamItemKind.Separator => length == _sourceWidth + 8,
+                _ => length == _sourceWidth + 12,
+            };
+            if (!valid) throw new InvalidDataException("R22 range entry has an invalid size.");
+            items.Add(item);
+            position += length;
+        }
+        if (position != input.Length) throw new InvalidDataException("R22 range has unplanned bytes.");
+
+        RangeResult result;
+        try { result = RewriteRange(input, items, 0, items.Count); }
+        catch (NeedsRemapping) { return []; }
+
+        using var output = new MemoryStream();
+        using var writer = new BinaryWriter(output);
+        var stats = result.Stats;
+        writer.Write(stats.Records);
+        writer.Write(stats.RecordsRewritten);
+        writer.Write(stats.RootBlocks);
+        writer.Write(stats.RootBlocksRewritten);
+        writer.Write(stats.OtherBlocks);
+        writer.Write(stats.OtherBlocksRewritten);
+        writer.Write(stats.Failures.Count);
+        foreach (var (reason, count) in stats.Failures)
+        {
+            writer.Write(reason);
+            writer.Write(count);
+        }
+        writer.Write(result.Ids?.Length ?? 0);
+        if (result.Ids != null)
+            foreach (int id in result.Ids) writer.Write(id);
+        foreach (int end in result.Ends) writer.Write(end);
+        writer.Write(result.Bytes.Span);
+        return output.ToArray();
+    }
+
+    private RangeResult?[]? RewriteBrowserRanges(byte[] source, List<StreamItem> items, List<(int First, int End)> ranges,
+        Func<byte[], byte[], byte[]> dispatch)
+    {
+        using var plan = new MemoryStream();
+        using var writer = new BinaryWriter(plan);
+        writer.Write(ranges.Count);
+        foreach (var (first, end) in ranges)
+        {
+            int start = items[first].Start;
+            var last = items[end - 1];
+            writer.Write(start);
+            writer.Write(last.Start + last.Length - start);
+            writer.Write(end - first);
+            for (int i = first; i < end; i++)
+            {
+                var item = items[i];
+                writer.Write(item.Start - start);
+                writer.Write(item.Length);
